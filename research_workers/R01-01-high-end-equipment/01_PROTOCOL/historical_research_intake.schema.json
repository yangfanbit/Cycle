{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://threec.local/research/intake/historical_research_intake.schema.json",
  "title": "ThreeC Historical Research Intake Package",
  "description": "Research Agent -> ThreeC Agent 的交付结构（交接格式）。这不是 Research DB schema：不得据此新增 SQLite 表/列。配套协议：research/intake/HISTORICAL_UNIVERSE_INTAKE_PROTOCOL_v0_1.md",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intake_protocol_version",
    "research_round_id",
    "task_id",
    "task_scope",
    "generated_at",
    "source_commit",
    "macro_theme_proposals",
    "campaign_candidates",
    "evidence",
    "sources",
    "securities",
    "exclusions",
    "conflicts",
    "cross_task_notes",
    "research_questions",
    "quality_summary"
  ],
  "properties": {
    "intake_protocol_version": {
      "type": "string",
      "const": "0.1",
      "description": "必须等于协议版本。"
    },
    "research_round_id": {
      "type": "string",
      "pattern": "^R[0-9]{2}$",
      "description": "研究轮次，如 R01。"
    },
    "task_id": {
      "type": "string",
      "pattern": "^R[0-9]{2}-[0-9]{2}$",
      "description": "任务号，如 R01-01。"
    },
    "task_scope": { "$ref": "#/definitions/task_scope" },
    "generated_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "Package 生成时间（ISO 8601，带时区）。"
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,40}$",
      "description": "产出该 Package 时的仓库 commit（provenance，必填）。"
    },
    "macro_theme_proposals": {
      "type": "array",
      "items": { "$ref": "#/definitions/macro_theme_proposal" }
    },
    "campaign_candidates": {
      "type": "array",
      "items": { "$ref": "#/definitions/campaign_candidate" }
    },
    "evidence": {
      "type": "array",
      "items": { "$ref": "#/definitions/evidence" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/definitions/source" }
    },
    "securities": {
      "type": "array",
      "items": { "$ref": "#/definitions/security" }
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "description": "强制字段且不得为空（协议 §8.2）：防止只收集成功案例。",
      "items": { "$ref": "#/definitions/exclusion" }
    },
    "conflicts": {
      "type": "array",
      "items": { "$ref": "#/definitions/conflict" }
    },
    "cross_task_notes": {
      "type": "array",
      "items": { "$ref": "#/definitions/cross_task_note" }
    },
    "research_questions": {
      "type": "array",
      "items": { "$ref": "#/definitions/research_question" }
    },
    "quality_summary": { "$ref": "#/definitions/quality_summary" }
  },

  "definitions": {

    "intake_id": {
      "type": "string",
      "pattern": "^R[0-9]{2}-[A-Z0-9]+-[A-Z]*[0-9]{3,}$",
      "description": "intake-local ID，必须带 round 前缀。禁止 canonical DB ID（C-* / RC-* / TH-* / rule_* / summer_* ...）。"
    },

    "iso_date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },

    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"],
      "description": "研究置信度。不是概率、不是胜率、不是分数、不得用于排序。"
    },

    "source_tier": {
      "type": "integer",
      "enum": [1, 2, 3, 4]
    },

    "source_type": {
      "type": "string",
      "enum": [
        "exchange",
        "regulator",
        "company_announcement",
        "industry_association",
        "media_tier2",
        "media_tier3",
        "media_tier4",
        "research_report",
        "website",
        "forum_blog",
        "social_media",
        "other"
      ]
    },

    "evidence_role": {
      "type": "string",
      "enum": ["supporting", "contradicting", "context"]
    },

    "temporal_relation": {
      "type": "string",
      "enum": ["contemporaneous", "prior", "subsequent", "retrospective", "unknown"]
    },

    "support_kind": {
      "type": "string",
      "enum": ["historical_fact_support", "point_in_time_support", "retrospective_context"]
    },

    "research_status": {
      "type": "string",
      "enum": ["PROVISIONAL", "CONFLICT", "INSUFFICIENT"],
      "description": "Research Agent 不得声明 VERIFIED。"
    },

    "date_precision": {
      "type": "string",
      "enum": ["EXACT_DATE", "DATE_WINDOW", "PHASE_WINDOW", "UNKNOWN"]
    },

    "classification_proposal": {
      "type": "string",
      "enum": ["theme_campaign", "industry_trend", "event_driven", "mixed", "unclear"]
    },

    "task_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "family_directions", "years", "priority_a_years", "priority_b_years", "included_scope", "excluded_scope"],
      "properties": {
        "task_id": { "type": "string", "pattern": "^R[0-9]{2}-[0-9]{2}$" },
        "family_directions": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "本任务的 family 方向（自然语言，未经 CMTR 解析）。"
        },
        "years": { "$ref": "#/definitions/year_range" },
        "priority_a_years": { "$ref": "#/definitions/year_range" },
        "priority_b_years": { "$ref": "#/definitions/year_range" },
        "included_scope": { "type": "string", "minLength": 1 },
        "excluded_scope": { "type": "string", "minLength": 1 }
      }
    },

    "year_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "to": { "type": "integer", "minimum": 1990, "maximum": 2100 }
      }
    },

    "macro_theme_proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "proposed_name", "theme_name_candidates", "proposal_kind", "rationale"],
      "properties": {
        "proposal_id": { "$ref": "#/definitions/intake_id" },
        "proposed_name": { "type": "string", "minLength": 1 },
        "theme_name_candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "交给 CMTR v1（theme_taxonomy.py）解析的原始主题名称。"
        },
        "proposal_kind": {
          "type": "string",
          "enum": ["EXISTING_MACRO", "NEW_MACRO_CANDIDATE", "SUB_THEME", "CROSS_FAMILY", "MECHANISM"]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "known_overlap": { "type": "array", "items": { "type": "string" } },
        "notes": { "type": ["string", "null"] }
      }
    },

    "campaign_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_id",
        "title",
        "year",
        "macro_theme_proposal",
        "theme_name_candidates",
        "theme_summary",
        "date_candidates",
        "lifecycle",
        "classification_proposal",
        "drivers",
        "evidence_ids",
        "security_ids",
        "research_status",
        "confidence",
        "point_in_time_notes",
        "why_campaign",
        "why_not",
        "notes"
      ],
      "properties": {
        "candidate_id": { "$ref": "#/definitions/intake_id" },
        "title": { "type": "string", "minLength": 1 },
        "year": { "type": "integer", "minimum": 1990, "maximum": 2100 },
        "macro_theme_proposal": {
          "type": "string",
          "minLength": 1,
          "description": "提案（proposal）。最终 Macro Theme 由 ThreeC Agent 走 CMTR v1 决定。"
        },
        "theme_name_candidates": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" },
          "description": "CMTR v1 的输入名称（原始主题名）。"
        },
        "theme_summary": { "type": "string", "minLength": 1 },
        "date_candidates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "peak", "end"],
          "properties": {
            "start": { "type": "array", "items": { "$ref": "#/definitions/date_candidate" } },
            "peak": { "type": "array", "items": { "$ref": "#/definitions/date_candidate" } },
            "end": { "type": "array", "items": { "$ref": "#/definitions/date_candidate" } }
          }
        },
        "lifecycle": {
          "type": "array",
          "items": { "$ref": "#/definitions/lifecycle_segment" }
        },
        "classification_proposal": { "$ref": "#/definitions/classification_proposal" },
        "drivers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "accelerator", "turning", "ending"],
          "properties": {
            "start": { "type": "array", "items": { "type": "string" } },
            "accelerator": { "type": "array", "items": { "type": "string" } },
            "turning": { "type": "array", "items": { "type": "string" } },
            "ending": { "type": "array", "items": { "type": "string" } }
          }
        },
        "evidence_ids": {
          "type": "array",
          "items": { "$ref": "#/definitions/intake_id" }
        },
        "security_ids": {
          "type": "array",
          "items": { "$ref": "#/definitions/intake_id" }
        },
        "research_status": { "$ref": "#/definitions/research_status" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "point_in_time_notes": { "type": "string", "minLength": 1 },
        "why_campaign": { "type": "string", "minLength": 1 },
        "why_not": { "type": "string", "minLength": 1 },
        "possible_duplicate_of": {
          "type": "array",
          "items": { "type": "string" },
          "description": "可能与其他任务/候选重复的 intake-local id 或说明。不得因重复而自行删除。"
        },
        "notes": { "type": "string" }
      }
    },

    "date_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date_precision", "basis", "confidence"],
      "properties": {
        "date_precision": { "$ref": "#/definitions/date_precision" },
        "date": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "window_start": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "window_end": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "phase_note": { "type": ["string", "null"] },
        "basis": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } },
        "confidence": { "$ref": "#/definitions/confidence" },
        "alternative_dates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["date", "basis"],
            "properties": {
              "date": { "$ref": "#/definitions/iso_date" },
              "basis": { "type": "string", "minLength": 1 },
              "source_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } }
            }
          }
        },
        "conflict_note": { "type": ["string", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "date_precision": { "const": "EXACT_DATE" } }, "required": ["date_precision"] },
          "then": {
            "required": ["date"],
            "properties": {
              "date": { "$ref": "#/definitions/iso_date" },
              "window_start": { "type": "null" },
              "window_end": { "type": "null" }
            }
          }
        },
        {
          "if": { "properties": { "date_precision": { "const": "DATE_WINDOW" } }, "required": ["date_precision"] },
          "then": {
            "required": ["window_start", "window_end"],
            "properties": {
              "date": { "type": "null" },
              "window_start": { "$ref": "#/definitions/iso_date" },
              "window_end": { "$ref": "#/definitions/iso_date" }
            }
          }
        },
        {
          "if": { "properties": { "date_precision": { "const": "PHASE_WINDOW" } }, "required": ["date_precision"] },
          "then": { "required": ["phase_note"] }
        }
      ]
    },

    "lifecycle_segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage_proposal", "start", "end"],
      "properties": {
        "stage_proposal": {
          "type": "string",
          "description": "阶段提案。最终阶段沿用 Research Model v1.0 §7（MAIN_RISE / PEAK / RETRACEMENT / DECLINING / SECONDARY / ENDED）。",
          "enum": ["MAIN_RISE", "PEAK", "RETRACEMENT", "DECLINING", "SECONDARY", "ENDED", "UNKNOWN"]
        },
        "start": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "end": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "basis": { "type": ["string", "null"] },
        "notes": { "type": ["string", "null"] }
      }
    },

    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "claim",
        "evidence_role",
        "evidence_type",
        "source_id",
        "confidence",
        "independence_group",
        "temporal_relation",
        "support_kind",
        "description"
      ],
      "properties": {
        "evidence_id": { "$ref": "#/definitions/intake_id" },
        "claim": {
          "type": "string",
          "minLength": 1,
          "description": "claim = 事实陈述（不是研究叙事、不是不确定性说明）。"
        },
        "evidence_role": { "$ref": "#/definitions/evidence_role" },
        "evidence_type": {
          "type": "string",
          "description": "行情数据 / 媒体 / 官方文件 / 行业文件 等（自由文本，沿用既有口径）。",
          "minLength": 1
        },
        "event_date": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "evidence_date": {
          "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }],
          "description": "来源发布/可得日期。"
        },
        "source_id": { "$ref": "#/definitions/intake_id" },
        "confidence": { "$ref": "#/definitions/confidence" },
        "independence_group": {
          "type": "string",
          "minLength": 1,
          "description": "独立性分组。不同 group 才算独立证据。同源转引必须同 group。"
        },
        "same_origin": { "type": "boolean" },
        "retelling": { "type": "boolean" },
        "primary_source": { "type": "boolean" },
        "temporal_relation": { "$ref": "#/definitions/temporal_relation" },
        "support_kind": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/support_kind" }
        },
        "point_in_time_note": {
          "type": ["string", "null"],
          "description": "temporal_relation 为 subsequent / retrospective 时必填：说明其不得作为同期催化。"
        },
        "description": { "type": "string", "minLength": 1 }
      }
    },

    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "title", "publisher", "source_type", "tier", "independence_group"],
      "properties": {
        "source_id": { "$ref": "#/definitions/intake_id" },
        "title": { "type": "string", "minLength": 1 },
        "url": { "type": ["string", "null"] },
        "no_url_reason": {
          "type": ["string", "null"],
          "description": "url 为空时必填：说明为何无可引用 URL（纸质/内部/不可得）。"
        },
        "publisher": { "type": "string", "minLength": 1 },
        "author": { "type": ["string", "null"] },
        "published_at": { "oneOf": [{ "$ref": "#/definitions/iso_date" }, { "type": "null" }] },
        "captured_at": { "type": ["string", "null"] },
        "source_type": { "$ref": "#/definitions/source_type" },
        "tier": { "$ref": "#/definitions/source_tier" },
        "independence_group": { "type": "string", "minLength": 1 },
        "description": { "type": ["string", "null"] }
      }
    },

    "security": {
      "type": "object",
      "additionalProperties": false,
      "required": ["security_id", "name", "role", "basis", "source_ids", "point_in_time_note"],
      "properties": {
        "security_id": { "$ref": "#/definitions/intake_id" },
        "ticker": { "type": ["string", "null"] },
        "name": { "type": "string", "minLength": 1 },
        "exchange": { "type": ["string", "null"] },
        "role": {
          "type": "string",
          "enum": ["leader", "second_leader", "representative", "follow"]
        },
        "basis": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/intake_id" } },
        "point_in_time_note": {
          "type": "string",
          "minLength": 1,
          "description": "必须区分 Historical Leader Set（retrospective）与 Point-in-Time Basket。"
        },
        "survivorship_aware": { "type": "boolean" }
      }
    },

    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exclusion_id", "subject", "reason_code", "rationale"],
      "properties": {
        "exclusion_id": { "$ref": "#/definitions/intake_id" },
        "subject": { "type": "string", "minLength": 1 },
        "reason_code": {
          "type": "string",
          "enum": [
            "OBSERVATION_ONLY",
            "SINGLE_STOCK_EVENT",
            "SAME_CAMPAIGN",
            "INSUFFICIENT_EVIDENCE",
            "NOT_INDEPENDENT_MACRO_THEME",
            "NOT_A_CAMPAIGN",
            "OUT_OF_SCOPE",
            "OTHER"
          ]
        },
        "rationale": { "type": "string", "minLength": 1 },
        "source_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } },
        "evidence_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } }
      }
    },

    "conflict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conflict_id", "subject", "positions", "resolution"],
      "properties": {
        "conflict_id": { "$ref": "#/definitions/intake_id" },
        "subject": { "type": "string", "minLength": 1 },
        "positions": {
          "type": "array",
          "minItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position", "source_ids"],
            "properties": {
              "position": { "type": "string", "minLength": 1 },
              "source_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } }
            }
          }
        },
        "resolution": {
          "type": "string",
          "enum": ["UNRESOLVED", "RESOLVED_PREFERRED", "KEEP_BOTH"],
          "description": "冲突不得被自动取舍。KEEP_BOTH 是合法状态。"
        },
        "note": { "type": ["string", "null"] }
      }
    },

    "cross_task_note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["note_id", "kind", "note"],
      "properties": {
        "note_id": { "$ref": "#/definitions/intake_id" },
        "kind": {
          "type": "string",
          "enum": ["POSSIBLE_DUPLICATE", "OVERLAP", "BOUNDARY", "HANDOFF"]
        },
        "target_task_id": { "type": ["string", "null"], "pattern": "^R[0-9]{2}-[0-9]{2}$" },
        "related_candidate_ids": { "type": "array", "items": { "type": "string" } },
        "note": { "type": "string", "minLength": 1 }
      }
    },

    "research_question": {
      "type": "object",
      "additionalProperties": false,
      "required": ["question_id", "question"],
      "properties": {
        "question_id": { "$ref": "#/definitions/intake_id" },
        "question": { "type": "string", "minLength": 1 },
        "why_it_matters": { "type": ["string", "null"] },
        "related_candidate_ids": { "type": "array", "items": { "$ref": "#/definitions/intake_id" } }
      }
    },

    "quality_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counts", "confidence_distribution", "coverage_notes", "known_gaps", "no_quantity_kpi_acknowledged"],
      "properties": {
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["campaign_candidates", "evidence", "sources", "securities", "exclusions", "conflicts"],
          "properties": {
            "campaign_candidates": { "type": "integer", "minimum": 0 },
            "evidence": { "type": "integer", "minimum": 0 },
            "sources": { "type": "integer", "minimum": 0 },
            "securities": { "type": "integer", "minimum": 0 },
            "exclusions": { "type": "integer", "minimum": 0 },
            "conflicts": { "type": "integer", "minimum": 0 }
          },
          "description": "描述性计数，不是产出目标。"
        },
        "confidence_distribution": {
          "type": "object",
          "additionalProperties": false,
          "required": ["high", "medium", "low"],
          "properties": {
            "high": { "type": "integer", "minimum": 0 },
            "medium": { "type": "integer", "minimum": 0 },
            "low": { "type": "integer", "minimum": 0 }
          }
        },
        "coverage_notes": { "type": "string", "minLength": 1 },
        "known_gaps": { "type": "array", "items": { "type": "string" } },
        "no_quantity_kpi_acknowledged": {
          "type": "boolean",
          "const": true,
          "description": "必须为 true：显式确认本任务没有以数量为产出目标（协议 §9）。"
        }
      }
    }
  }
}
