{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "types": ["vitest/globals", "node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@exports/*": ["exports/*"],
      "@current/*": ["research/current/*"],
      "@observation/*": ["research/research/reports/*"],
      "@market/*": ["research/current/market_snapshots/*"]
    }
  },
  "include": ["src", "data", "exports", "research/current", "tests", "vite.config.ts"]
}
