# ============================================================
# ThreeC .gitignore（Monorepo 合并版）
# 合并自原 Cycle/.gitignore 与 Cycle-Research/.gitignore
# ============================================================

# ---- Node / 前端 ----
node_modules/
dist/
*.local
*.tsbuildinfo

# ---- Python ----
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/
.venv/
venv/

# ---- 构建产物 / 缓存 ----
build/
.cache/
.vite/
# vitest / 本地脚本用的临时目录（Windows EPERM 规避：TEMP 指向项目内）
.tmp/
# Vite 解析 vite.config.ts 时写出的临时 bundle（进程被强杀时会残留）
vite.config.ts.timestamp-*.mjs

# ---- 本地环境 / 密钥 ----
.env
.env.*
!.env.example

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 系统 ----
.DS_Store
Thumbs.db
desktop.ini

# ---- 工具/项目元数据（本地，不提交） ----
# 项目 memory 的 canonical 位置是 `.workbuddy/memory/`（仓库约定，见 AGENTS.md）。
# `.workbuddy-ai/` 是 AI 平台默认目录名，本仓库**不使用**；一并忽略以防误提交 /
# 防止「另一套 memory」再次混入工作区（2026-09-17 Repository Recovery 的成因之一）。
.workbuddy/
.workbuddy-ai/
_temp_*.txt
_*.ps1

# ---- 迁移/审计临时文件（不提交） ----
_audit_*.txt
_baseline_*.txt
_backup_*.txt
_migrate_*.txt
_migrate_*.ps1
_migrate_*.sh
_post_*.txt
_post_*.ps1
_semantic_diff*.txt
_semantic_diff*.ps1
_script_diffs.txt
_scriptdiff.ps1
_cleanup*.ps1
_unify_export*.ps1
_install_*.ps1
_run_subtree*.ps1
_prep_ascii.ps1
_diag_*.ps1
_layout_check.ps1
_verify_subtree.ps1
_subtree.sh
_probe*.sh

# ============================================================
# 明确【不】忽略（重要）
# ============================================================
# research/database/cycle_research.db
#   —— Research 明确依赖可回查数据库，继续提交 Git。
#      不因通用最佳实践自动忽略 SQLite。
# research/data/market/**/*.csv
#   —— 行情原始与归一化 CSV，研究对象，提交 Git。
